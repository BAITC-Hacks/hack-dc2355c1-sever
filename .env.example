# Скопируйте в .env и вставьте ключи. .env в git не коммитится.

# --- OpenAI: сильный роутер, эмбеддинги, fallback STT/TTS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- NVIDIA (OpenAI-совместимый API): быстрый путь роутера. Пусто = каскад выключен.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- ElevenLabs: STT (Scribe) и TTS
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Провайдеры: elevenlabs | openai | browser
STT_PROVIDER=elevenlabs
TTS_PROVIDER=elevenlabs

# --- Роутер
FAST_CONFIDENCE_THRESHOLD=0.8
CLARIFY_THRESHOLD=0.45
TOP_K_CANDIDATES=8
HISTORY_TURNS=6
