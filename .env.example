# Скопируйте в .env и вставьте ключ. .env в git НЕ коммитится.
OPENAI_API_KEY=sk-...

# Дешёвая модель для отладки. Точное имя подскажет smoke_test.py.
MODEL=gpt-5-mini

# Умная модель для финального демо. Переключайтесь на неё в последний момент.
MODEL_SMART=gpt-5

# CACHE=0 отключает кэш (нужно, если проверяете недетерминированность).
CACHE=1
