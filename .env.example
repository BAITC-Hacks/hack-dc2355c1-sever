# Скопируйте в .env и вставьте ключи. .env в git не коммитится.

# --- OpenAI: сильный роутер, эмбеддинги, fallback STT/TTS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Модель исполнителя сценария (вызов действий + ответ клиенту)
EXECUTOR_MODEL=gpt-4.1
OPENAI_EMBED_MODEL=text-embedding-3-small
# STT OpenAI (основной при STT_PROVIDER=openai); whisper-1 плохо пишет казахский
OPENAI_STT_MODEL=gpt-4o-transcribe

# --- NVIDIA (OpenAI-совместимый API): быстрый путь роутера. Пусто = каскад выключен.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- ElevenLabs: STT (Scribe) и TTS
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
# Подсказка языка для Scribe: без неё казахский распознаётся как турецкий
ELEVENLABS_STT_LANGUAGE=kaz
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Провайдеры: elevenlabs | openai | browser
# openai (gpt-4o-transcribe) точнее на смешанной ru/kk речи; elevenlabs — запасной
STT_PROVIDER=openai
TTS_PROVIDER=elevenlabs

# --- Роутер
ROUTE_THRESHOLD=0.75
CLARIFY_THRESHOLD=0.45
FAST_CONFIDENCE_THRESHOLD=0.85
USE_FAST_PATH=true
# Исполнитель параллельно с роутером, когда реплика похожа на продолжение текущей темы
SPECULATIVE_EXECUTOR=true
# 0 = весь каталог (40 сценариев) в промпте; >0 = сужение до top-K эмбеддингами
TOP_K_CANDIDATES=0
HISTORY_TURNS=6
